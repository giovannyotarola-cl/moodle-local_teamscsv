 class utils {
+    /** @var int Execution-time isolation contract; callers must require this before registering/linking. */
+    public const MANAGED_MEMBERSHIP_GUARD_VERSION = 1;
+
+    /**
+     * Read-only exclusion, independent of plugin code, config and live mapping validity.
+     * Registry rows are durable: only explicit operator action may release a course.
+     * Never memoize or swallow lookup errors. A broken registry must not authorize writes.
+     *
+     * @param int $courseid Course ID, or zero for a group-only writer.
+     * @param string $groupobjectid Also protect shared, historical and newly remapped groups.
+     * @return bool Whether upstream membership/lifecycle writes must be skipped.
+     */
+    public static function is_membership_managed(int $courseid = 0, string $groupobjectid = ''): bool {
+        global $DB;
+
+        // Installing this patch before TeamsCSV is safe; no new settings or schema writes.
+        if (!$DB->get_manager()->table_exists('local_teamscsv_map')) {
+            return false;
+        }
+        if ($courseid && $DB->record_exists('local_teamscsv_map', ['courseid' => $courseid])) {
+            return true;
+        }
+        if ($groupobjectid === '') {
+            return false;
+        }
+
+        $sql = "SELECT 1
+                  FROM {local_teamscsv_map} m
+                  JOIN {local_o365_objects} o ON o.moodleid = m.courseid
+                 WHERE o.type = :type AND o.objectid = :objectid";
+        if ($DB->record_exists_sql($sql, ['type' => 'group', 'objectid' => $groupobjectid])) {
+            return true;
+        }
+
+        // Do NOT join on m.generationid: unlink/relink or a broken pointer cannot release old Teams.
+        $sql = "SELECT 1
+                  FROM {local_teamscsv_map} m
+                  JOIN {local_teamscsv_generation} g ON g.courseid = m.courseid
+                 WHERE g.teamid = :teamid";
+        return $DB->record_exists_sql($sql, ['teamid' => $groupobjectid]);
+    }
